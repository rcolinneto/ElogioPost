NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=

# Opcional, só pra rodar migrations localmente via Management API
# (scripts/run-sql.mjs) — não é lido pelo app. Gere em
# supabase.com/dashboard/account/tokens.
SUPABASE_ACCESS_TOKEN=

# Cobrança do plano Pago via Asaas (asaas.com). Chave de API em
# Minha conta > Integrações > API. Deixe ASAAS_ENV vazio/"sandbox" pra testar
# sem mexer em dinheiro real; só use "production" com a chave de produção.
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# Token forte (32-255 caracteres) que você mesmo gera e cadastra ao criar o
# Webhook no painel do Asaas — é o que garante que só o Asaas consegue
# atualizar o status da assinatura de um negócio.
ASAAS_WEBHOOK_TOKEN=
